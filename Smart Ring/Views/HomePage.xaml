<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Smart_Ring.Componentes"
             x:Class="Smart_Ring.Views.HomePage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource PrimaryAccent}" 
              Padding="20,15" 
              ColumnDefinitions="*, Auto">

            <Label Text="HOME" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}" 
                   VerticalOptions="Center" />

            <StackLayout Grid.Column="1" 
                         Orientation="Horizontal" 
                         Spacing="10" 
                         VerticalOptions="Center">
                <Label Text="Agregar dispositivo" 
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center" 
                       FontSize="14"/>

                <Frame WidthRequest="36" 
                       HeightRequest="36" 
                       CornerRadius="18" 
                       BackgroundColor="Transparent" 
                       BorderColor="{StaticResource TextPrimary}"
                       Padding="0" 
                       HasShadow="False">
                    <Label Text="+" 
                           FontSize="20" 
                           TextColor="{StaticResource TextPrimary}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="0,0,0,2"/>
                </Frame>
            </StackLayout>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label Text="¡Bienvenido Juan García!" 
                       FontSize="24" 
                       TextColor="{StaticResource TextPrimary}" 
                       Margin="0,5,0,5" />

                <Frame Style="{StaticResource CardStyle}" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Historial de Fatiga" 
                               FontSize="18" 
                               HorizontalOptions="Center" 
                               TextColor="{StaticResource TextPrimary}"/>

                        <Grid HeightRequest="160" Margin="10,0">
                            <BoxView HeightRequest="1" Color="#E0E0E0" VerticalOptions="Start" Margin="25,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center" Margin="25,0,0,0"/>
                            <BoxView HeightRequest="1" Color="#E0E0E0" VerticalOptions="End" Margin="25,0,0,0"/>

                            <VerticalStackLayout VerticalOptions="FillAndExpand" HorizontalOptions="Start" WidthRequest="25" Spacing="35">
                                <Label Text="40" FontSize="11" TextColor="#999999"/>
                                <Label Text="30" FontSize="11" TextColor="#999999"/>
                                <Label Text="20" FontSize="11" TextColor="#999999"/>
                                <Label Text="10" FontSize="11" TextColor="#999999"/>
                                <Label Text="0" FontSize="11" TextColor="#999999" Margin="6,0,0,0"/>
                            </VerticalStackLayout>

                            <Polyline Points="35,130 85,90 145,85 210,35 275,25"
                                      Stroke="{StaticResource PrimaryAccentDark}"
                                      StrokeThickness="3"
                                      Margin="25,0,0,0"/>

                            <AbsoluteLayout Margin="25,0,0,0" InputTransparent="True">
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource PrimaryAccentDark}" AbsoluteLayout.LayoutBounds="31,126" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource PrimaryAccentDark}" AbsoluteLayout.LayoutBounds="81,86" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource PrimaryAccentDark}" AbsoluteLayout.LayoutBounds="141,81" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource PrimaryAccentDark}" AbsoluteLayout.LayoutBounds="206,31" />
                                <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource PrimaryAccentDark}" AbsoluteLayout.LayoutBounds="271,21" />
                            </AbsoluteLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *, *, *, *" Margin="25,0,0,0">
                            <Label Grid.Column="0" Text="ene 2021" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            <Label Grid.Column="1" Text="ene 2022" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            <Label Grid.Column="2" Text="ene 2023" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            <Label Grid.Column="3" Text="ene 2024" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                            <Label Grid.Column="4" Text="ene 2025" FontSize="10" TextColor="#999999" HorizontalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="ÍNDICE DE ALERTA" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                Text="▶ Ver porcentaje de alerta" 
                Style="{StaticResource PillButton}" 
                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                Clicked="OnAlertIndexTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#F5F0FF" HasShadow="False" Padding="0" VerticalOptions="Center">
                            <Label Text="⚠️" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="RITMO CARDÍACO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                Text="▶ Medir BPM" 
                Style="{StaticResource PillButton}" 
                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                Clicked="OnHeartRateTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#FFF0F2" HasShadow="False" Padding="0" VerticalOptions="Center">
                            <Label Text="❤️" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="OXÍGENO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                Text="▶ Medir oxígeno en sangre" 
                Style="{StaticResource PillButton}" 
                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                Clicked="OnOxygenTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#E57373" HasShadow="False" Padding="0" VerticalOptions="Center">
                            <Label Text="O₂" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <comp:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>