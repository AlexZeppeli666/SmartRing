<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:Smart_Ring.Componentes"
             x:Class="Smart_Ring.Views.HomePage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource PrimaryAccent}" 
              Padding="20,15" 
              ColumnDefinitions="*, Auto">

            <Label Text="HOME" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}" 
                   VerticalOptions="Center" />

            <StackLayout Grid.Column="1" 
                         Orientation="Horizontal" 
                         Spacing="10" 
                         VerticalOptions="Center">
                <Label Text="Agregar dispositivo" 
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center" 
                       FontSize="14"/>

                <Frame WidthRequest="36" 
                       HeightRequest="36" 
                       CornerRadius="18" 
                       BackgroundColor="Transparent" 
                       BorderColor="{StaticResource TextPrimary}"
                       Padding="0" 
                       HasShadow="False">
                    <Label Text="+" 
                           FontSize="20" 
                           TextColor="{StaticResource TextPrimary}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Margin="0,0,0,2"/>
                </Frame>
            </StackLayout>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label x:Name="LabelWelcome" 
                       Text="¡Bienvenido(a)!" 
                       FontSize="20"
                       TextColor="{StaticResource TextPrimary}" />

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Historial de Fatiga" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>

                        <GraphicsView x:Name="FatigueChartView" 
                                      HeightRequest="150" 
                                      HorizontalOptions="FillAndExpand" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="ÍNDICE DE ALERTA" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Ver porcentaje de alerta" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnAlertIndexTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#F5F0FF" HasShadow="False" Padding="0" VerticalOptions="Center">
                            <Image Source="alerta.png" 
                                   WidthRequest="50" 
                                   HeightRequest="50" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="RITMO CARDÍACO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Medir BPM" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnHeartRateTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#FFF0F2" HasShadow="False" Padding="0" VerticalOptions="Center">
                            <Image Source="cardio.png" 
                                   WidthRequest="60" 
                                   HeightRequest="60" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Frame>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardStyle}" Padding="20,15">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="OXÍGENO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Medir oxígeno en sangre" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnOxygenTapped"/>

                        <Frame Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" WidthRequest="60" HeightRequest="60" CornerRadius="30" BackgroundColor="#E57373" 
                               HasShadow="False" 
                               Padding="0" 
                               VerticalOptions="Center">
                            <Label Text="O₂" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <comp:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>