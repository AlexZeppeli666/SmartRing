<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Smart_Ring.Componentes"
             xmlns:comp="clr-namespace:Smart_Ring.Componentes"
             x:Class="Smart_Ring.Views.HomePage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto, *, Auto">

        <controls:TopBar Grid.Row="0" Title="HOMEPAGE" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Label x:Name="LabelWelcome" 
                       Text="¡Bienvenido(a)!" 
                       FontSize="20"
                       TextColor="{StaticResource TextPrimary}" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Historial de Fatiga" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>

                        <GraphicsView x:Name="FatigueChartView" 
                                      HeightRequest="150" 
                                      HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="ÍNDICE DE ALERTA" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Ver porcentaje de alerta" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnAlertIndexTapped"/>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                WidthRequest="60" HeightRequest="60" 
                                BackgroundColor="#F5F0FF" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Image Source="alerta.png" 
                                   WidthRequest="50" 
                                   HeightRequest="50" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="RITMO CARDÍACO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Medir BPM" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnHeartRateTapped"/>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                WidthRequest="60" HeightRequest="60" 
                                BackgroundColor="#FFF0F2" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Image Source="cardio.png" 
                                   WidthRequest="60" 
                                   HeightRequest="60" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="OXÍGENO" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Row="1" Grid.Column="0" 
                                Text="▶ Medir oxígeno en sangre" 
                                Style="{StaticResource PillButton}" 
                                HeightRequest="45" HorizontalOptions="Start" Padding="20,0"
                                Clicked="OnOxygenTapped"/>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
                                WidthRequest="60" HeightRequest="60" 
                                BackgroundColor="#E57373" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="30"/>
                            </Border.StrokeShape>
                            <Label Text="O₂" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <comp:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>