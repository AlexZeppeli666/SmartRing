<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Smart_Ring.Controls"
             x:Class="Smart_Ring.Views.OxygenDetailPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:TopBar Grid.Row="0" Title="OXÍGENO EN SANGRE" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="22">

                <!-- Mini panel de tendencia (decorativo, simplificado del mockup) -->
                <Grid HeightRequest="120" ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="28">
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="20" Margin="14,0,4,0">
                        <Label Text="100" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="95" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                        <Label Text="90" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>
                    <Frame Grid.Column="0" WidthRequest="84" HeightRequest="100" CornerRadius="36"
                           BackgroundColor="{StaticResource PrimaryAccent}" HorizontalOptions="End"
                           VerticalOptions="Center" Padding="0" HasShadow="False">
                        <Label x:Name="LabelDate" Text="19/jun" FontSize="13" TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                </Grid>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" x:Name="LabelSpo2" Text="-- %" FontSize="34" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            <Frame Grid.Column="1" WidthRequest="56" HeightRequest="56" CornerRadius="28"
                                   BackgroundColor="{StaticResource DangerSoft}" Padding="0" HasShadow="False">
                                <Label Text="O&#8322;" FontSize="18" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                        </Grid>

                        <Grid x:Name="RangeBarGrid" HeightRequest="50" SizeChanged="OnRangeBarSizeChanged">
                            <Frame BackgroundColor="{StaticResource PrimaryAccent}" CornerRadius="25"
                                   Padding="0" HasShadow="False" />
                            <BoxView x:Name="IndicatorLine" WidthRequest="3" HeightRequest="50"
                                     Color="{StaticResource TextPrimary}"
                                     HorizontalOptions="Start" IsVisible="False" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*">
                            <Label Grid.Column="0" Text="70" FontSize="14" TextColor="{StaticResource PrimaryAccentDark}" HorizontalOptions="Center" />
                            <Label Grid.Column="1" Text="80" FontSize="14" TextColor="{StaticResource PrimaryAccentDark}" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="90" FontSize="14" TextColor="{StaticResource PrimaryAccentDark}" HorizontalOptions="Center" />
                            <Label Grid.Column="3" Text="100" FontSize="14" TextColor="{StaticResource PrimaryAccentDark}" HorizontalOptions="Center" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="Recuerde que la medición de oxígeno en la sangre está pensada únicamente para controlar su estado físico y bienestar, y no para el diagnóstico y tratamiento de ninguna enfermedad."
                       FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" />

    </Grid>

</ContentPage>
