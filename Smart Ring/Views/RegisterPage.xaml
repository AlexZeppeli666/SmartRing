<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Smart_Ring.Views.RegisterPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="32,60" Spacing="0" VerticalOptions="Center">

            <VerticalStackLayout Spacing="14" HorizontalOptions="Center" Margin="0,0,0,30">
                <Frame WidthRequest="150" HeightRequest="150" CornerRadius="75"
                       BackgroundColor="{StaticResource PrimaryAccent}"
                       Padding="0" HasShadow="False" HorizontalOptions="Center">
                    <Label Text="&#128141;" FontSize="64" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
                <Label Text="SMART RING" FontSize="34" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="18">
                    <Label Text="Formulario de Registro" FontSize="16" TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="EntryFullName" Placeholder="Nombre Completo" Style="{StaticResource UnderlineEntry}" />
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="EntryUsername" Placeholder="Usuario" Style="{StaticResource UnderlineEntry}" />
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <Entry x:Name="EntryPassword" Placeholder="Contraseña" IsPassword="True"
                               Style="{StaticResource UnderlineEntry}" />
                        <BoxView HeightRequest="1.5" Color="{StaticResource PrimaryAccentDark}" />
                    </VerticalStackLayout>

                    <Button Text="Registrarse"
                            Style="{StaticResource PillButton}"
                            Margin="0,10,0,0"
                            Clicked="OnRegisterClicked" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="¿Tienes cuenta? Da click aquí"
                   TextColor="{StaticResource PrimaryAccentDark}"
                   FontSize="14"
                   TextDecorations="Underline"
                   HorizontalOptions="Center"
                   Margin="0,24,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
