<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Smart_Ring.Componentes"
             x:Class="Smart_Ring.Views.ProfilePage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <controls:TopBar Grid.Row="0" Title="PERFIL" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="120" 
                            HeightRequest="120"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource ChipBackground}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60"/>
                        </Border.StrokeShape>

                        <Image Source="profile.png" 
                               Aspect="AspectFill"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>

                    <Label x:Name="LabelName" Text="UserName" FontSize="22"
                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Border Style="{StaticResource CardBorderStyle}">
                    <VerticalStackLayout Spacing="14">

                        <Border BackgroundColor="{StaticResource PrimaryAccent}" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="Género:" 
                       FontAttributes="Bold"
                       FontSize="14" 
                       TextColor="{StaticResource TextPrimary}" 
                       VerticalOptions="Center" />

                                <Label x:Name="LabelGender" 
                       Text="No especificado" 
                       FontSize="14" 
                       TextColor="{StaticResource TextSecondary}" 
                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border BackgroundColor="{StaticResource PrimaryAccent}" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Dispositivo Vinculado" FontAttributes="Bold" FontSize="14"
                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Smart Ring Pro   A4:C1:38:7F:2B   v2.4.1" FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{StaticResource PrimaryAccent}" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Contacto de emergencia" FontAttributes="Bold" FontSize="14"
                       TextColor="{StaticResource TextPrimary}" />

                                <VerticalStackLayout Spacing="2">
                                    <Entry x:Name="EntryEmergencyName" Placeholder="Nombre completo"
                           Style="{StaticResource UnderlineEntry}" />
                                    <BoxView HeightRequest="1.5" Color="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="2">
                                    <Entry x:Name="EntryEmergencyPhone" Placeholder="Celular" Keyboard="Telephone"
                           Style="{StaticResource UnderlineEntry}" />
                                    <BoxView HeightRequest="1.5" Color="{StaticResource TextPrimary}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                                    <Button Text="Guardar" Style="{StaticResource SecondaryPillButton}"
                            FontSize="12" HeightRequest="40" WidthRequest="90"
                            Clicked="OnSaveEmergencyContactClicked" />
                                    <Button Text="Editar" Style="{StaticResource SecondaryPillButton}"
                            FontSize="12" HeightRequest="40" WidthRequest="90"
                            Clicked="OnEditEmergencyContactClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{StaticResource PrimaryAccent}" StrokeThickness="0" Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Mensajes SMS" FontAttributes="Bold" FontSize="14"
                           TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Enviar SMS a contacto de emergencia para compartir ubicación en tiempo real."
                           FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" x:Name="SwitchSms" IsToggled="True"
                        OnColor="{StaticResource PrimaryAccentDark}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <Button Text="Cerrar Sesión"
                        TextColor="White"
                        BackgroundColor="{StaticResource PrimaryAccentDark}" 
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="22"
                        HeightRequest="44"
                        WidthRequest="180"
                        HorizontalOptions="Center"
                        Margin="0,16,0,24"
                        Clicked="OnLogoutTapped" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" />

    </Grid>

</ContentPage>
