<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             android:Application.WindowSoftInputModeAdjust="Resize"
             x:Class="Smart_Ring.Views.LoginPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <Grid Padding="32,60" VerticalOptions="Fill">
            <VerticalStackLayout Spacing="0" VerticalOptions="Center">

                <VerticalStackLayout Spacing="14" HorizontalOptions="Center" Margin="0,0,0,30">
                    <Frame WidthRequest="150" HeightRequest="150" CornerRadius="75"
                           BackgroundColor="{StaticResource PrimaryAccent}"
                          Padding="0" HasShadow="False" HorizontalOptions="Center"
                          IsClippedToBounds="True">
                        <Image Source="smartring.png" Aspect="AspectFill" />
                    </Frame>
                    <Label Text="SMART RING" FontSize="34" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Frame Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="18">
                        <Label Text="Ingresa tus datos" FontSize="16" TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center" />

                        <Grid RowDefinitions="Auto, Auto">
                            <Entry x:Name="EntryUsername" 
                                   Placeholder="Usuario" 
                                   Style="{StaticResource UnderlineEntry}"
                                   Grid.Row="0" />

                            <BoxView Grid.Row="1" HeightRequest="1.5" Color="{StaticResource TextPrimary}" InputTransparent="True">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" 
                                                 Binding="{Binding IsFocused, Source={x:Reference EntryUsername}}" 
                                                 Value="True">
                                        <Setter Property="Color" Value="{StaticResource PrimaryAccent}" />
                                        <Setter Property="HeightRequest" Value="2" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </Grid>

                        <Grid RowDefinitions="Auto, Auto">
                            <Entry x:Name="EntryPassword" 
                                   Placeholder="Contraseña" 
                                   IsPassword="True"
                                   Style="{StaticResource UnderlineEntry}"
                                   Grid.Row="0" />

                            <BoxView Grid.Row="1" HeightRequest="1.5" Color="{StaticResource TextPrimary}" InputTransparent="True">
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" 
                                                 Binding="{Binding IsFocused, Source={x:Reference EntryPassword}}" 
                                                 Value="True">
                                        <Setter Property="Color" Value="{StaticResource PrimaryAccent}" />
                                        <Setter Property="HeightRequest" Value="2" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>
                        </Grid>

                        <Button Text="Iniciar Sesión"
                                Style="{StaticResource PillButton}"
                                Margin="0,10,0,0"
                                Clicked="OnLoginClicked" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="¿No tienes cuenta? Regístrate Aquí"
                       TextColor="{StaticResource PrimaryAccentDark}"
                       FontSize="14"
                       TextDecorations="Underline"
                       HorizontalOptions="Center"
                       Margin="0,24,0,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>