<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Smart_Ring.Componentes"
             xmlns:comp="clr-namespace:Smart_Ring.Componentes"
             x:Class="Smart_Ring.Views.WearableAccessoryPage"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barra Superior -->
        <controls:TopBar Grid.Row="0" Title="WEARABLE" />

        <!-- Contenido Desplazable -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Info de Dispositivo y Batería -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border Grid.Column="0" 
                            WidthRequest="110" 
                            HeightRequest="110"
                            BackgroundColor="{StaticResource ChipBackground}" 
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>

                        <Image Source="smartring.png" 
                               Aspect="AspectFill" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label x:Name="LabelBattery" Text="&#128267; 100%" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <HorizontalStackLayout Spacing="8">
                            <Label x:Name="LabelConnection" Text="Conectado" FontSize="16"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Ellipse x:Name="ConnectionDot" WidthRequest="14" HeightRequest="14"
                                     Fill="{StaticResource SuccessSoft}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Botones de Vinculación -->
                <Button x:Name="BtnLink" Text="VINCULAR" Style="{StaticResource SecondaryPillButton}"
                        Clicked="OnLinkClicked" />
                <Button x:Name="BtnUnlink" Text="DESVINCULAR" Style="{StaticResource SecondaryPillButton}"
                        Clicked="OnUnlinkClicked" />

                <!-- Grid de Ajustes Rápidos (Notificaciones y Batería) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" HeightRequest="140">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="RECIBIR NOTIFICACIONES" 
                                   FontAttributes="Bold" 
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Switch x:Name="SwitchNotifications" 
                                    IsToggled="True"
                                    HorizontalOptions="Center"
                                    OnColor="{StaticResource PrimaryAccentDark}"
                                    Toggled="OnAnySwitchToggled" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" HeightRequest="140">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="ALERTA DE BATERÍA" 
                                   FontAttributes="Bold" 
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Switch x:Name="SwitchBatteryAlert" 
                                    IsToggled="True"
                                    HorizontalOptions="Center"
                                    OnColor="{StaticResource PrimaryAccentDark}"
                                    Toggled="OnAnySwitchToggled" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Grid de Control de Intensidad Háptica (Slider) y Alarma (Botón Ejecutar) -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" HeightRequest="140">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                            <Label Text="INTENSIDAD (DURACIÓN)" 
                                   FontAttributes="Bold" 
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Label x:Name="LabelDurationVal" 
                                   Text="200 ms" 
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextSecondary}" />

                            <!-- El movimiento de este Slider disparará la vibración automáticamente de forma controlada -->
                            <Slider x:Name="SliderVibration"
                                    Minimum="50"
                                    Maximum="1000"
                                    Value="200"
                                    Margin="10,0"
                                    MinimumTrackColor="{StaticResource PrimaryAccentDark}"
                                    MaximumTrackColor="{StaticResource ChipBackground}"
                                    ThumbColor="{StaticResource PrimaryAccentDark}"
                                    ValueChanged="OnSliderValueChanged" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" HeightRequest="140">
                        <VerticalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="ALARMA" 
                                   FontAttributes="Bold" 
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource TextPrimary}" />

                            <Button x:Name="BtnAlarm" 
                                    Text="&#9654; EJECUTAR"
                                    Style="{StaticResource PillButton}"
                                    FontSize="11" 
                                    HeightRequest="38"
                                    WidthRequest="110"
                                    HorizontalOptions="Center"
                                    Clicked="OnExecuteAlarmClicked" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de Navegación Inferior -->
        <comp:BottomNavBar Grid.Row="2" />

    </Grid>
</ContentPage>