<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Smart_Ring.Componentes.TopBar">

    <Grid BackgroundColor="{StaticResource BarColor}"
          Padding="16,14"
          ColumnDefinitions="56,*,56"
          HeightRequest="76">

        <Border x:Name="BackButton"
                Grid.Column="0"
                WidthRequest="42" 
                HeightRequest="42"
                BackgroundColor="Transparent"
                Stroke="{StaticResource PrimaryAccentDark}"
                StrokeThickness="1"
                Padding="0"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="21"/>
            </Border.StrokeShape>

            <Label Text="&#8592;" FontSize="20" TextColor="{StaticResource PrimaryAccentDark}"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Border>

        <Label x:Name="LabelTitle"
               Grid.Column="1"
               Style="{StaticResource ScreenTitleLabel}"
               HorizontalOptions="Center" VerticalOptions="Center"
               LineBreakMode="TailTruncation" />
    </Grid>
</ContentView>