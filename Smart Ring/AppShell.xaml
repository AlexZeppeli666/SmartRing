<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Smart_Ring.Views"
       x:Class="Smart_Ring.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False">

    <TabBar Shell.TabBarIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
        <ShellContent ContentTemplate="{DataTemplate views:WearableAccessoryPage}" Route="WearableAccessoryPage" />
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
    </TabBar>

</Shell>