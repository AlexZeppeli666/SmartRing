<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Smart_Ring.Controls.TopBar">

    <Grid BackgroundColor="{StaticResource BarColor}"
          Padding="16,14"
          ColumnDefinitions="56,*,56"
          HeightRequest="76">

        <Frame Grid.Column="0"
               WidthRequest="42" HeightRequest="42" CornerRadius="21"
               BackgroundColor="Transparent"
               BorderColor="{StaticResource PrimaryAccentDark}"
               Padding="0" HasShadow="False"
               VerticalOptions="Center">
            <Label Text="&#8592;" FontSize="20" TextColor="{StaticResource PrimaryAccentDark}"
                   HorizontalOptions="Center" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Frame>

        <Label x:Name="LabelTitle"
               Grid.Column="1"
               Style="{StaticResource ScreenTitleLabel}"
               HorizontalOptions="Center" VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

    </Grid>

</ContentView>
